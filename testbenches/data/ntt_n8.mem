0000 // input[3] = 0
0000 // input[4] = 0
0000 // input[5] = 0
0000 // input[6] = 0
0000 // input[7] = 0
// expected decimal = [0, 0, 0, 0, 0, 0, 0, 0]
0000 // expected[0] = 0
0000 // expected[1] = 0
0000 // expected[2] = 0
0000 // expected[3] = 0
0000 // expected[4] = 0
0000 // expected[5] = 0
0000 // expected[6] = 0
0000 // expected[7] = 0

