// Sequential NTT memory-load N=8 input coefficients
// width=10 entries=8 radix=hex
// Format: <hex value> // [absolute_index] decimal=<decimal value>
001 // [0] decimal=1
004 // [1] decimal=4
007 // [2] decimal=7
00a // [3] decimal=10
00d // [4] decimal=13
010 // [5] decimal=16
002 // [6] decimal=2
005 // [7] decimal=5
