// Sequential NTT one-stage default-width input coefficients
// width=16 entries=8 radix=hex
// Format: <hex value> // [absolute_index] decimal=<decimal value>
0001 // [0] decimal=1
0002 // [1] decimal=2
0003 // [2] decimal=3
0004 // [3] decimal=4
0005 // [4] decimal=5
0006 // [5] decimal=6
0007 // [6] decimal=7
0008 // [7] decimal=8
